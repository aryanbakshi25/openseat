# ── Supabase ──
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Occuspace ──
# Provided by the Occuspace team
OCCUSPACE_API_TOKEN=your-occuspace-api-token

# ── LibCal ──
# Provided by Purdue Libraries admin
LIBCAL_CLIENT_ID=your-libcal-client-id
LIBCAL_CLIENT_SECRET=your-libcal-client-secret

# ── Alma Proxy ──
# Patron type lookup — provided by Purdue Libraries
ALMA_PROXY_URL=https://your-alma-proxy-endpoint.example.com/path
ALMA_PROXY_API_KEY=your-alma-proxy-api-key

# ── Admin ──
# Password for the /admin dashboard (shared with staff)
ADMIN_PASSWORD=your-admin-password
# Random 32+ byte hex secret for HMAC session cookies (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
ADMIN_SESSION_SECRET=your-session-secret

# ── Cron (Vercel) ──
# Secret to protect the /api/cron/* endpoints (required)
CRON_SECRET=your-cron-secret
